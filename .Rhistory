myPalette <- brewer.pal(5, "Pastel1")
jpeg("~/Desktop/SSH/MYCP/piechart.jpg",
width = 2000, height = 1600, res = 300)
pie(
tablepercentage,
labels = paste0(
names(tablepercentage),
