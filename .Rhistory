library(readxl)
library(tidyverse)
library(countrycode)
library(rnaturalearth)
library(sf)
library(RColorBrewer)
library(gtsummary)
library(gt)
# Import data (name of data is analysis.xlsx)
d11 <- read_excel("analysis.xlsx")
# Convert variables to factors
d11$`Country-Economy`<-as.factor(d11$`Country-Economy`)
d11$Gender <- as.factor(d11$Gender)
d11$`Socio-economic` <- as.factor(d11$`Socio-economic`)
d11$`Socio-behavioral` <- as.factor(d11$`Socio-behavioral`)
d11$Demographic <- as.factor(d11$Demographic)
d11$Biological <- as.factor(d11$Biological)
d11$Geographic <- as.factor(d11$Geographic)
d11$`Health System Capacity` <- as.factor(d11$`Health System Capacity`)
# Geographic distribution
country_counts <- as.data.frame(table(d11$Country))
names(country_counts) <- c("Country", "n")
country_counts$iso_a3 <- countrycode(
country_counts$Country,
origin = "country.name",
destination = "iso3c"
)
world <- ne_countries(
scale = "small",
returnclass = "sf"
)
world_joined <- world %>%
left_join(country_counts, by = "iso_a3")
ggplot(world_joined) +
geom_sf(aes(fill = n), color = "blue", size = 0.1) +
scale_fill_gradient(
low = "pink",
high = "brown",
na.value = "white"
) +
theme_minimal() +
labs(
title = "                          Countries from Included Studies"
) +
theme(
axis.text = element_blank(),
axis.ticks = element_blank(),
panel.grid = element_blank()
)
country_counts
library(readxl)
library(tidyverse)
library(countrycode)
library(rnaturalearth)
library(sf)
library(RColorBrewer)
library(gtsummary)
library(gt)
# Import data (name of data is analysis.xlsx)
d11 <- read_excel("analysis.xlsx")
# Convert variables to factors
d11$`Country-Economy`<-as.factor(d11$`Country-Economy`)
d11$Gender <- as.factor(d11$Gender)
d11$`Socio-economic` <- as.factor(d11$`Socio-economic`)
d11$`Socio-behavioral` <- as.factor(d11$`Socio-behavioral`)
d11$Demographic <- as.factor(d11$Demographic)
d11$Biological <- as.factor(d11$Biological)
d11$Geographic <- as.factor(d11$Geographic)
d11$`Health System Capacity` <- as.factor(d11$`Health System Capacity`)
# Geographic distribution
country_counts <- as.data.frame(table(d11$Country))
names(country_counts) <- c("Country", "n")
country_counts$iso_a3 <- countrycode(
country_counts$Country,
origin = "country.name",
destination = "iso3c"
)
world <- ne_countries(
scale = "small",
returnclass = "sf"
)
world_joined <- world %>%
left_join(country_counts, by = "iso_a3")
ggplot(world_joined) +
geom_sf(aes(fill = n), color = "blue", size = 0.1) +
scale_fill_gradient(
low = "pink",
high = "brown",
na.value = "white",
name = "Studies (n)"
) +
theme_minimal() +
labs(
title = "                          Countries from Included Studies"
) +
theme(
axis.text = element_blank(),
axis.ticks = element_blank(),
panel.grid = element_blank()
)
library(dplyr)
library(ggplot2)
library(countrycode)
library(rnaturalearth)
library(sf)
# 1. Count studies per country
country_counts <- as.data.frame(table(d11$Country))
names(country_counts) <- c("Country", "n")
# 2. Map country names to ISO3 codes
country_counts$iso_a3 <- countrycode(
country_counts$Country,
origin = "country.name",
destination = "iso3c"
)
# Check for unmatched names before moving on
if (any(is.na(country_counts$iso_a3))) {
warning("Unmatched countries: ",
paste(country_counts$Country[is.na(country_counts$iso_a3)], collapse = ", "))
}
# 3. World map geometry
world <- ne_countries(scale = "medium", returnclass = "sf")
# 4. Join counts onto the map
world_joined <- world %>%
left_join(country_counts, by = "iso_a3")
# 5. Plot
ggplot(world_joined) +
geom_sf(aes(fill = n), color = "grey40", linewidth = 0.1) +
scale_fill_gradientn(
colors = c("#fde0dd", "#c51b8a", "#49006a"),
na.value = "grey95",
name = "Studies (n)",
guide = guide_colorbar(
barwidth = 10, barheight = 0.5,
title.position = "top", title.hjust = 0.5
)
) +
coord_sf(crs = "+proj=robin") +   # Robinson projection — less distorted than default
labs(
title = "Countries Represented in Included Studies",
caption = "Grey = no studies included"
) +
theme_minimal(base_size = 13) +
theme(
plot.title = element_text(hjust = 0.5, face = "bold", size = 16),
plot.caption = element_text(hjust = 0.5, size = 9, color = "grey40"),
axis.text = element_blank(),
axis.title = element_blank(),
axis.ticks = element_blank(),
panel.grid = element_blank(),
legend.position = "bottom"
)
country_counts$iso_a3 <- countrycode(
country_counts$Country,
origin = "country.name",
destination = "iso3c"
)
world <- ne_countries(
scale = "small",
returnclass = "sf"
)
world_joined <- world %>%
left_join(country_counts, by = "iso_a3")
ggplot(world_joined) +
geom_sf(aes(fill = n), color = "blue", size = 0.1) +
scale_fill_gradient(
low = "pink",
high = "brown",
na.value = "white",
name = "Studies (n)",
breaks =  c (1,5,9)
) +
theme_minimal() +
labs(
title = "                          Countries from Included Studies"
) +
theme(
axis.text = element_blank(),
axis.ticks = element_blank(),
panel.grid = element_blank()
)
ggplot(world_joined) +
geom_sf(aes(fill = n), color = "blue", size = 0.1) +
