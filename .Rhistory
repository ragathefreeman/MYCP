library(haven)
library(readxl)
library(countrycode)
library(rnaturalearth)
library(ggplot2)
library(dplyr)
library(tidyr)
library(sf)
library(tidyverse)
library(RColorBrewer)
library(gtsummary)
library(gt)
# Import data
d11 <- read_excel("~/Desktop/analysis.xlsx")
# Geographic distribution
country_counts <- as.data.frame(table(d11$Country))
names(country_counts) <- c("Country", "n")
country_counts$iso_a3 <- countrycode(
country_counts$Country,
origin = "country.name",
destination = "iso3c"
)
world <- ne_countries(
scale = "small",
returnclass = "sf"
)
world_joined <- world %>%
left_join(country_counts, by = "iso_a3")
ggplot(world_joined) +
geom_sf(aes(fill = n), color = "blue", size = 0.1) +
scale_fill_gradient(
low = "pink",
high = "brown",
na.value = "white",
name = "Studies (n)"
) +
theme_minimal() +
labs(
title = "Geographic Distribution of Included Studies"
) +
theme(
axis.text = element_blank(),
axis.ticks = element_blank(),
panel.grid = element_blank()
)
ggsave(
"~/Desktop/country_map.png",
width = 10,
height = 6,
dpi = 500
)
# Health outcomes
raw_table <- table(
d11$`Health Outcomes based on WHO Framework`
)
tablepercentage <- prop.table(raw_table) * 100
print(tablepercentage)
myPalette <- brewer.pal(5, "Pastel1")
pie(
tablepercentage,
labels = paste0(
names(tablepercentage),
"\n(",
round(tablepercentage, 1),
"%)"
),
border = "green",
col = myPalette,
main = "Health outcomes based on included studies (n = 12)"
)
# Convert variables to factors
d11$Gender <- as.factor(d11$Gender)
d11$`Socio-economic` <- as.factor(d11$`Socio-economic`)
d11$`Socio-behavioral` <- as.factor(d11$`Socio-behavioral`)
d11$Demographic <- as.factor(d11$Demographic)
d11$Biological <- as.factor(d11$Biological)
d11$Geographic <- as.factor(d11$Geographic)
d11$`Health System Capacity` <- as.factor(d11$`Health System Capacity`)
# Count Yes responses
counts <- d11 %>%
select(
Gender,
Demographic,
`Socio-economic`,
`Socio-behavioral`,
Biological,
Geographic,
`Health System Capacity`
) %>%
summarise(
across(
everything(),
~ sum(. == "Yes", na.rm = TRUE)
)
) %>%
pivot_longer(
everything(),
names_to = "Factor",
values_to = "Count"
)
# Plot factors influencing health outcome
ggplot(
counts,
aes(
x = reorder(Factor, Count),
y = Count,
fill = Factor
)
) +
geom_col() +
geom_text(
aes(label = Count),
hjust = -1,
size = 3
) +
coord_flip() +
labs(
x = "Factor influencing health outcome",
y = "Number of Studies",
title = "Studies reporting health outcome (n = 12)"
) +
theme_minimal(base_size = 11) +
theme(
legend.position = "none"
)
ggsave(
"~/Desktop/SSH/MYCP/factors_influencing_outcome.png",
width = 10,
height = 6,
dpi = 300
)
# Table 1
table1 <- d11 |>
tbl_summary(
include = c(
YOP,
Design,
`Climatic Events`,
`Factor influencing outcome`
)
)
